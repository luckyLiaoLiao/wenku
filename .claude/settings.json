{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$changes = git status --porcelain; if ($changes) { git add -A; git commit -m 'chore: auto-save'; git push }",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "Auto-committing changes..."
          }
        ]
      }
    ]
  }
}
